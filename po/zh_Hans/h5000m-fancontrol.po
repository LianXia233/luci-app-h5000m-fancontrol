msgstr "目标 %s"

msgid "Target output"
msgstr "目标输出"

msgid "Temperature"
msgstr "温度"

msgid "Temperature hysteresis"
msgstr "温度滞回"

msgid "Temperature monitoring"
msgstr "温度监控"

msgid "Temperature unknown"
msgstr "温度未知"

