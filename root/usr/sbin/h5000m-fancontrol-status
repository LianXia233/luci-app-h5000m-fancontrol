#!/bin/sh
# Status interface kept for the rpcd ACL and for operators.
#
# `h5000m-fancontrol-status` with no argument reproduces the historical
# key=value output, so existing shell scripts keep working; the LuCI view calls
# it with `json` to get the typed contract documented in docs/status-api.md.
# The Rust controller does the work, this wrapper only fixes the path.
exec /usr/sbin/h5000m-fancontrol status "$@"
