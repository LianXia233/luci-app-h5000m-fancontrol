#!/bin/sh
# One-time, repeatable migration for luci-app-h5000m-fancontrol 3.x.
#
# The UCI option set did not change during the 2.x series, so an upgraded
# router keeps its configured mode, curves and safety values. This script only
#
#   - migrates the historical `off` mode name to `kernel`,
#   - fills options that older releases could have left absent, but never
#     overwrites a value the operator already set,
#   - drops options that were removed in 1.x,
#   - stamps schema_version=3,
#   - enables and (re)starts the service so the Rust controller replaces the
#     shell controller that 2.x shipped at the same path.
#
# Everything is guarded by the schema version, so re-running it is a no-op.
# The file lives in /etc/uci-defaults, so sysupgrade keeps it out of the way
# and first boot after a sysupgrade runs it once.

set -u

schema="$(uci -q get h5000m_fancontrol.settings.schema_version || echo 0)"
case "$schema" in ''|*[!0-9]*) schema=0 ;; esac

fill() {
	# fill <option> <default>: only write when the option is absent or empty.
	# Deliberately no `local`: BusyBox ash supports it but the script has to
	# stay valid POSIX sh, and the two parameters are used exactly once.
	[ -n "$(uci -q get "h5000m_fancontrol.settings.$1" || true)" ] || \
		uci -q set "h5000m_fancontrol.settings.$1=$2"
}

if [ "${schema}" -lt 3 ]; then
	[ "$(uci -q get h5000m_fancontrol.settings.mode || true)" = "off" ] && \
		uci -q set h5000m_fancontrol.settings.mode='kernel'

	fill temp_source 'max'
	fill interval '5'
	fill hysteresis '2'
	fill down_delay '30'
	fill start_pwm '192'
	fill start_boost_ms '700'
	fill fail_pwm '255'
	fill curve_silent '20:0,35:0,40:50,55:50,70:60,85:75,95:100'
	fill curve_balanced '20:0,35:0,40:50,55:60,70:75,85:90,95:100'
	fill curve_performance '20:0,30:60,45:70,60:82,75:92,85:100'
	fill curve_custom '20:0,40:50,55:60,70:75,85:90,95:100'

	for removed in min_pwm max_pwm low_temp high_temp; do
		uci -q delete "h5000m_fancontrol.settings.${removed}" 2>/dev/null
	done

	uci -q set h5000m_fancontrol.settings.schema_version='3'
	uci -q commit h5000m_fancontrol
fi

/etc/init.d/h5000m-fancontrol enable >/dev/null 2>&1 || true
/etc/init.d/h5000m-fancontrol restart >/dev/null 2>&1 || true

exit 0
