#!/bin/sh /etc/rc.common

# START and USE_PROCD are read by /etc/rc.common, which sources this file.
# shellcheck disable=SC2034
START=98
# shellcheck disable=SC2034
USE_PROCD=1

# procd supervises the Rust controller as a foreground process. The controller
# holds the exclusive control lock for its whole lifetime, releases it on
# SIGTERM and leaves the fan at its last output, so a restart never strands the
# fan at full or zero speed.
start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/h5000m-fancontrol daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

# Saving the configuration must not restart the controller: SIGHUP makes the
# running daemon wake up, reload the config and run one control cycle. If the
# service is not running, stay quiet, because a uci commit must not silently
# start or re-enable it.
reload_service() {
	procd_send_signal h5000m-fancontrol '*' HUP 2>/dev/null || true
}

service_triggers() {
	procd_add_reload_trigger h5000m_fancontrol
}
