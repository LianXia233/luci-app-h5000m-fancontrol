#!/bin/sh /etc/rc.common

# START and USE_PROCD are consumed by /etc/rc.common, which sources this file.
# shellcheck disable=SC2034
START=98
# shellcheck disable=SC2034
USE_PROCD=1

# procd runs the Rust controller in the foreground and respawns it. The
# daemon keeps the fan at its last output during restarts and releases its
# lock and legacy thermal policy file on SIGTERM.
start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/h5000m-fancontrol daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# SIGHUP makes the daemon reload its configuration and run one control
	# cycle immediately. If the service is not running, stay quiet - a
	# configuration commit must not silently re-enable it.
	procd_send_signal h5000m-fancontrol '' SIGHUP 2>/dev/null || true
}

service_triggers() {
	procd_add_reload_trigger h5000m_fancontrol
}
